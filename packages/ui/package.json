{
  "name": "@rtds/ui",
  "version": "0.1.0",
  "description": "React UI components for the RTDS design system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "development": "./src/components/*.tsx",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./base.css": "./base.css",
    "./playground.css": "./playground.css"
  },
  "files": [
    "dist",
    "styles.css",
    "base.css",
    "playground.css"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Lint disabled - use apps lint'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rtds/tokens": "workspace:*",
    "@rtds/tw-preset": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.480.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
